    var col = (p && p.room && typeof p.room.col === 'number') ? p.room.col : -1;
    if (col >= 0 && col < (s.rooms || []).length) {
      s.roomIndex = col;
    } else {
      for (var i = 0; i < (s.rooms || []).length; i++) {
